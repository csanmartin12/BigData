# Configuración de HDFS para la imagen apache/hadoop (envtoconf.py la escribe en
# core-site.xml / hdfs-site.xml al arrancar). Común a namenode y datanode.
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.namenode.http-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.namenode.name.dir=/data/namenode
HDFS-SITE.XML_dfs.datanode.data.dir=/data/datanode
# Un solo datanode: una réplica por bloque
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# El datanode se registra con hostname "localhost" (ver docker-compose.yml)
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
